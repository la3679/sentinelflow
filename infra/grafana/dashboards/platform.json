{
  "uid": "sentinelflow-platform",
  "title": "SentinelFlow \u2014 platform",
  "description": "Is the pipeline moving, and is anything stuck. The first dashboard to open, and the one a runbook links to.",
  "tags": ["sentinelflow", "platform"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "SentinelFlow dashboards",
      "tags": ["sentinelflow"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "datasource": null,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Synthetic data.** SentinelFlow is an independent educational project. Every number on this dashboard describes generated transactions and a demo stack on one machine. None of it describes a real payment portfolio, and no figure here should be quoted as a benchmark."
      }
    },
    {
      "type": "stat",
      "title": "Ingestion",
      "description": "Transactions accepted per second, averaged over five minutes. Created only \u2014 replays and conflicts are on the API dashboard, because they are a caller's behaviour rather than throughput.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(sentinelflow_transactions_ingested_total{application=\"sentinelflow-api\",outcome=\"created\"}[5m]))",
          "legendFormat": "created/s",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Assessments",
      "description": "Risk assessments written per second. Compare with ingestion: a persistent gap means the consumer is behind, which the lag panel below will agree with.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(sentinelflow_risk_assessments_total{application=\"sentinelflow-api\"}[5m]))",
          "legendFormat": "assessed/s",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Consumer lag",
      "description": "Records the transaction-risk group has not yet read, summed across partitions. Steady near zero is healthy; climbing means the consumer cannot keep up, and Runbook 3 is what to do about it.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": ["green"],
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(sentinelflow_kafka_consumer_lag{application=\"sentinelflow-api\"})",
          "legendFormat": "lag",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Dead-letter depth",
      "description": "Records the dead-letter topic holds **within its 30-day retention window**. This is a depth, not a backlog of unhandled failures: nothing consumes that topic, so the number falls when retention expires rather than when somebody fixes something. A *rising* value is the signal; a flat non-zero one is history.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": ["text"],
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(sentinelflow_kafka_dlq_depth{application=\"sentinelflow-api\"})",
          "legendFormat": "depth",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingestion, by what ingestion did",
      "description": "Created, replayed and conflicted. A replay rate that climbs is a caller retrying; a conflict rate above zero is a caller whose idempotency keys have broken, and it belongs in a bug report rather than on a graph nobody reads.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(sentinelflow_transactions_ingested_total{application=\"sentinelflow-api\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Assessments, scored against degraded",
      "description": "A degraded assessment is one scored by the rules alone because the scoring service did not answer (ADR-0008 \u00a73). It is a real answer, not a failure \u2014 but a sustained degraded rate means the model is contributing nothing, and the scoring dashboard says why.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(sentinelflow_risk_assessments_total{application=\"sentinelflow-api\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox depth",
      "description": "Events written and not yet published. The outbox is a deliberate delay (ADR-0005), so a small non-zero value is normal. Monotonic growth is not: it means the relay is not draining, and Runbook 4 covers it.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(sentinelflow_outbox_pending{application=\"sentinelflow-api\"})",
          "legendFormat": "pending",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(sentinelflow_outbox_failed{application=\"sentinelflow-api\"})",
          "legendFormat": "failed",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scoring breaker",
      "description": "1 on the state the breaker is in. OPEN means scoring calls are being refused without an attempt and every assessment is degrading \u2014 which is the breaker working, and a reason to look at the scoring service rather than at this graph.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sentinelflow_scoring_breaker_state{application=\"sentinelflow-api\"}",
          "legendFormat": "{{state}}",
          "range": true,
          "refId": "A"
        }
      ]
    }
  ]
}
