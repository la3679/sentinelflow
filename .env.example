# SentinelFlow local environment - TEMPLATE
#
# Copy to .env and fill in the secret values, or run `make bootstrap`, which
# generates them for you. .env is git-ignored and must never be committed.
#
#   cp .env.example .env      # then edit
#   make bootstrap            # or let it generate the secrets
#
# Every variable is listed with its default, whether it is required, whether it
# is sensitive, and which component reads it. A variable with no default is
# required: compose fails to start rather than falling back to something
# guessable.
#
# These values configure a stack that binds to your own machine and contains
# nothing but synthetic data. None of them is a production credential, and this
# stack is not a deployment target.

# =============================================================================
# Secrets - REQUIRED, no default. Generated by `make bootstrap`.
# =============================================================================

# Sensitive | required | read by: postgres, and from Phase 2 by apps/api
# Local database password. Generate with:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Sensitive | required | read by: grafana
# Local Grafana admin password. Generate with:
#   openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# Sensitive | required | read by: apps/api
# Signs and verifies operator tokens (ADR-0012). At least 32 characters, or the
# API refuses to start: a shorter key is weaker than the HMAC-SHA256 it claims,
# and nothing downstream would report it. Generate with:
#   openssl rand -base64 48
SENTINELFLOW_JWT_SECRET=

# Sensitive | required when seeding | read by: apps/api
# The password given to every seeded demo operator - analyst.one, analyst.two,
# administrator.one and auditor.one. Required whenever SENTINELFLOW_SEED_ENABLED
# is true, with no default, because a value in the repository would be the same
# password on every machine that ever ran the seed. Generate with:
#   openssl rand -base64 24
SENTINELFLOW_DEMO_OPERATOR_PASSWORD=

# =============================================================================
# PostgreSQL - not sensitive
# =============================================================================

# Default: sentinelflow | read by: postgres, apps/api
POSTGRES_DB=sentinelflow

# Default: sentinelflow | read by: postgres, apps/api
POSTGRES_USER=sentinelflow

# Default: 5432 | read by: compose (host port publication)
# Change if something else on your machine already owns 5432.
POSTGRES_PORT=5432

# =============================================================================
# Kafka - not sensitive
# =============================================================================

# Default: 5L6g3nShT-eMCtK--X86sw | read by: kafka
# KRaft cluster id. Keep it stable: changing it after the volume has been
# formatted makes the broker refuse to start against its existing data
# directory. `make reset-demo` is the way to start over.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# Default: 29092 | read by: compose (host port publication)
# The host-facing listener. Containers use kafka:9092 internally and are
# unaffected by this.
KAFKA_HOST_PORT=29092

# =============================================================================
# Application ports - not sensitive
# =============================================================================

# Default: 8080 | read by: compose, apps/api
API_PORT=8080

# Default: 8000 | read by: compose, apps/scoring
SCORING_PORT=8000

# Default: 5173 | read by: compose (the console container listens on 8080)
WEB_PORT=5173

# Default: http://localhost:5173,http://localhost:5174 | read by: apps/api
# Which web origins a browser may let read this API (ADR-0013). The console is a
# separate origin from the API, so without a matching entry here every request
# the console makes is refused by the browser before this service sees it.
#
# The two defaults are the compose console (WEB_PORT above) and the Vite dev
# server. Comma-separated, exact matches: a scheme, a host and a port, with no
# trailing slash. "*" is refused at startup - a wildcard is not a permission.
SENTINELFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Default: http://localhost:8080/api/v1 | read by: apps/web at BUILD time
# Where the console sends its requests. Baked into the bundle by Vite when the
# console is built, not read at runtime, so changing it means rebuilding the
# web image - `make up --build` or `docker compose build web`.
#
# If you change API_PORT above, change this too; if you change this, add the
# console's origin to SENTINELFLOW_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# =============================================================================
# Demo data - not sensitive, and synthetic by construction
# =============================================================================

# Default: false | read by: apps/api
# Loads synthetic customers, accounts, merchants and analyst logins at startup.
# Off everywhere, including local: a service that populates whatever database
# it is pointed at is a service nobody can safely point at anything. Turn it on
# deliberately, for one run. A second run over already-seeded data writes
# nothing.
SENTINELFLOW_SEED_ENABLED=false

# Default: 20260826 | read by: apps/api
# The same value produces the same dataset on any machine. Quote it in a bug
# report; pin it in CI. Changing it changes every generated row.
SENTINELFLOW_SEED=20260826

# Default: DEMO | read by: apps/api
# CI (20 customers), DEMO (200), or LOCAL (2000). See docs/data/DATA_PROVENANCE.md.
SENTINELFLOW_SEED_PROFILE=DEMO

# =============================================================================
# Scoring context - not sensitive
# =============================================================================

# Default: 24h | read by: apps/api
# How much account history crosses the scoring boundary (ADR-0008), and how much
# goes into the labelled training export (ADR-0010 section 1). 24h is the longest
# window any current feature is defined over - the 24-hour amount sum. Shortening
# it does not make that feature cheaper, it makes it wrong: the value is sent on
# every request as lookbackWindowSeconds so the scoring service warns rather than
# answering confidently from history it never received.
SENTINELFLOW_SCORING_LOOKBACK_WINDOW=24h

# Default: 200 | read by: apps/api
# The cap on recentTransactions. 200 is the contract's maxItems, and the
# application clamps to it - a larger value here would build requests the scoring
# service is required to reject, which presents as a scoring outage rather than
# as a misconfiguration. Lower it to send less; you cannot raise it.
SENTINELFLOW_SCORING_MAX_RECENT_TRANSACTIONS=200

# Default: false | read by: apps/api
# Writes the labelled training dataset at startup (ADR-0010 section 1). Off
# everywhere, including local, for the same reason as the seed: an application
# that writes files and reads the whole transaction table wherever it is pointed
# is one nobody can safely point anywhere. `make export-dataset` sets it for one
# recreate of the api service and then puts it back.
SENTINELFLOW_SCORING_EXPORT_ENABLED=false

# Default: false | read by: apps/api
# Whether to replace an existing export. An export is reproducible, so rewriting
# one is either pointless work or the loss of a dataset whose metrics someone has
# already published. The export refuses and names this variable rather than
# overwriting quietly.
SENTINELFLOW_SCORING_EXPORT_OVERWRITE=false

# =============================================================================
# Observability - not sensitive
# =============================================================================

# Default: 9090 | read by: compose
PROMETHEUS_PORT=9090

# Default: 3000 | read by: compose
GRAFANA_PORT=3000

# Default: 3200 | read by: compose (tempo)
# Tempo's query API, published so a trace can be fetched with curl when a
# dashboard is the thing under suspicion. The collector that feeds it has no
# published port on purpose: nothing outside the compose network sends it
# spans, and an unauthenticated trace-ingest endpoint on the host is a write
# surface for no gain.
TEMPO_PORT=3200

# Default: true | read by: apps/api
# Whether the API exports spans to the collector. On in compose, where the
# collector exists; off by default in application.yaml, so a local
# `./mvnw spring-boot:run` does not retry a connection to something that was
# never started. Tracing itself stays on either way, so trace and span ids
# still reach every log line.
SENTINELFLOW_OTLP_EXPORT_ENABLED=true

# Default: 1.0 | read by: apps/api
# The fraction of traces recorded. 1.0 locally because this stack is idle
# between bursts and sampling a tenth of a four-record replay gives a trace
# view that is empty when somebody looks at it (ADR-0016 section 5). The first
# number to change if this ever runs somewhere continuous.
SENTINELFLOW_TRACING_SAMPLE_RATE=1.0

# Default: admin | read by: grafana
GRAFANA_ADMIN_USER=admin

# =============================================================================
# Build and runtime identity - not sensitive
# =============================================================================

# Default: dev | read by: compose (image tag)
SENTINELFLOW_VERSION=dev

# Default: unknown | read by: apps/scoring (/info), apps/api (service.version
# on every structured log line)
# Set by CI so a running instance can be traced back to the commit that built
# it. Locally: SENTINELFLOW_GIT_SHA=$(git rev-parse HEAD)
SENTINELFLOW_GIT_SHA=unknown

# Default: INFO | read by: apps/scoring
# One of: CRITICAL, ERROR, WARNING, INFO, DEBUG
SCORING_LOG_LEVEL=INFO

# Default: json | read by: apps/scoring
# One of: json, console. JSON in the container because a log line is only
# structured if something can read the fields (ADR-0016 section 4); `console`
# is what a local `python -m sentinelflow_scoring` uses, because a person
# reading a traceback should not be reading escaped JSON. Set this to console
# to make `docker compose logs scoring` readable while debugging by eye.
SCORING_LOG_FORMAT=json

# Default: ecs | read by: apps/api (as LOGGING_STRUCTURED_FORMAT_CONSOLE)
# One of: ecs, logstash, gelf - or empty for Spring Boot's ordinary pattern
# encoder, which is what a local `./mvnw spring-boot:run` gets because nothing
# sets the variable there. ecs is a published schema with names for the fields
# this application already has, so a collector needs no hand-written mapping.
API_LOG_FORMAT=ecs
