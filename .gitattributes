# Normalize all text files to LF in the repository and in the working tree.
#
# Without this, a Windows checkout with core.autocrlf=true rewrites every file
# to CRLF, and Prettier — which expects LF — reports thousands of spurious
# "Delete CR" errors. Pinning eol=lf keeps lint and format checks reproducible
# on Windows, Linux, and CI alike.
* text=auto eol=lf

# Generated by TanStack Router. Committed, never hand-edited.
src/routeTree.gen.ts linguist-generated=true

# Lockfiles are generated; keep them out of diff review noise.
bun.lock -diff linguist-generated=true

# Windows-only scripts must keep CRLF to remain executable by cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must keep LF even on Windows checkouts.
*.sh text eol=lf

# Binary assets: never diff, never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.jar binary
*.joblib binary
