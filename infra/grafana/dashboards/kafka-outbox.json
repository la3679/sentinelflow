{
  "uid": "sentinelflow-kafka-outbox",
  "title": "SentinelFlow \u2014 Kafka and outbox",
  "description": "The asynchronous half: what is waiting to be published, what has been consumed, and what could not be.",
  "tags": ["sentinelflow", "kafka", "outbox"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "SentinelFlow dashboards",
      "tags": ["sentinelflow"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "datasource": null,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Synthetic data.** SentinelFlow is an independent educational project. Every number on this dashboard describes generated transactions and a demo stack on one machine. None of it describes a real payment portfolio, and no figure here should be quoted as a benchmark."
      }
    },
    {
      "type": "stat",
      "title": "Oldest unpublished event",
      "description": "How stale the event stream is. The honest cost of the outbox (ADR-0005): nothing here is real-time, and this is the number that says by how much.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": ["green"],
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "max(sentinelflow_outbox_oldest_age_seconds{application=\"sentinelflow-api\"})",
          "legendFormat": "age",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pending",
      "description": "Events written and not yet published.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": ["green"],
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(sentinelflow_outbox_pending{application=\"sentinelflow-api\"})",
          "legendFormat": "pending",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Failed",
      "description": "Events that exhausted their attempts. Should be zero; anything else needs an operator, and the row itself carries the last error.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": ["green"],
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(sentinelflow_outbox_failed{application=\"sentinelflow-api\"})",
          "legendFormat": "failed",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Consumer lag",
      "description": "Summed across the topic's three partitions. Per-partition is what kafka-consumer-groups.sh is for, and Runbook 3 has the command.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": ["green"],
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(sentinelflow_kafka_consumer_lag{application=\"sentinelflow-api\"})",
          "legendFormat": "lag",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Publication rate",
      "description": "Events leaving the outbox, by outcome. A failure rate above zero with a flat success rate is a broker problem; both falling together is an ingestion problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(sentinelflow_outbox_publish_total{application=\"sentinelflow-api\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Publication duration, p95",
      "description": "How long one send waits for the broker's acknowledgement. The relay holds row locks while it waits, so this being slow is a database problem as well as a broker one.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sentinelflow_outbox_publish_duration_seconds_bucket{application=\"sentinelflow-api\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consumer outcomes",
      "description": "What the transaction-risk consumer did with each event. `duplicate` is normal traffic under at-least-once delivery, not an error \u2014 the ledger did its job.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(sentinelflow_consumer_events_total{application=\"sentinelflow-api\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dead-letter depth",
      "description": "Records in the dead-letter topic within its 30-day retention. **A depth, not a backlog.** Nothing consumes that topic, so this falls when retention expires rather than when somebody deals with a record. Watch the slope, not the value: the local demo database carries thousands from a defect that has since been fixed.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(sentinelflow_kafka_dlq_depth{application=\"sentinelflow-api\"})",
          "legendFormat": "{{topic}}",
          "range": true,
          "refId": "A"
        }
      ]
    }
  ]
}
