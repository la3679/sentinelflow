{
  "uid": "sentinelflow-api",
  "title": "SentinelFlow \u2014 API and database",
  "description": "The HTTP surface and the connection pool underneath it.",
  "tags": ["sentinelflow", "api"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "SentinelFlow dashboards",
      "tags": ["sentinelflow"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "datasource": null,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Synthetic data.** SentinelFlow is an independent educational project. Every number on this dashboard describes generated transactions and a demo stack on one machine. None of it describes a real payment portfolio, and no figure here should be quoted as a benchmark."
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate, by status",
      "description": "Every served route, grouped by status. Grouped by the route template rather than the path, which is what keeps this a handful of series instead of one per transaction.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"sentinelflow-api\"}[5m]))",
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "Computed here with histogram_quantile over the buckets the application publishes, never as a percentile the application computed for itself (ADR-0016 \u00a73) \u2014 a pre-computed percentile cannot be aggregated or re-windowed, so it answers only the question the process was already asked.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"sentinelflow-api\"}[5m])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"sentinelflow-api\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"sentinelflow-api\"}[5m])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Server errors",
      "description": "5xx only. A 4xx is a caller being told something, and putting it on the same graph trains everyone to ignore both.\n\n`or vector(0)` because Actuator creates a series per status it has actually served: a service that has never returned a 500 has no such series at all, and the panel would read \"No data\" where it means \"none\".",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"sentinelflow-api\",status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "5xx/s",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slowest routes, p95",
      "description": "By route template. The one to read when the percentile panel moves and it is not obvious which endpoint did it.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"sentinelflow-api\"}[5m])))",
          "legendFormat": "{{uri}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Connection pool",
      "description": "Hikari, named sentinelflow-api-pool so a connection holding a lock is attributable in pg_stat_activity. Pending above zero means requests are queuing for a connection, which shows up as latency long before it shows up as an error.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "hikaricp_connections_active{application=\"sentinelflow-api\"}",
          "legendFormat": "active",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "hikaricp_connections_idle{application=\"sentinelflow-api\"}",
          "legendFormat": "idle",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "hikaricp_connections_pending{application=\"sentinelflow-api\"}",
          "legendFormat": "pending",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "hikaricp_connections_max{application=\"sentinelflow-api\"}",
          "legendFormat": "max",
          "range": true,
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap",
      "description": "Used against committed. A saw-tooth is a healthy collector; a rising floor is not.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_used_bytes{application=\"sentinelflow-api\",area=\"heap\"})",
          "legendFormat": "used",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_committed_bytes{application=\"sentinelflow-api\",area=\"heap\"})",
          "legendFormat": "committed",
          "range": true,
          "refId": "B"
        }
      ]
    }
  ]
}
