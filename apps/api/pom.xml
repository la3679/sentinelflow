<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    The Spring Boot parent supplies the dependency management BOM and the
    plugin versions. Dependency versions below are deliberately absent where
    the BOM manages them: pinning a managed version by hand is how a project
    silently drifts out of a tested combination. See ADR-0003.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.github.la3679.sentinelflow</groupId>
  <artifactId>sentinelflow-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>SentinelFlow API</name>
  <description>Transaction ingestion, risk assessment and alert lifecycle service for SentinelFlow.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- Versions the Spring Boot BOM does not manage. See docs/research/RESEARCH_LOG.md. -->
    <spotless-maven-plugin.version>3.10.0</spotless-maven-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <palantir-java-format.version>2.86.0</palantir-java-format.version>

    <!--
      The PostgreSQL image the Testcontainers suites run against. It must match
      compose.yaml: a schema verified on one major version and deployed on
      another has been verified against a different type system, and PostgreSQL
      18's uuidv7() does not exist before 18 at all.
    -->
    <postgres.test.image>postgres:18.6-alpine</postgres.test.image>

    <!--
      Lets `make test-integration` run only the Testcontainers suites.
      Surefire and Failsafe share `skipTests`, so skipping unit tests alone
      needs a property of our own rather than a built-in one.
    -->
    <skipUnitTests>false</skipUnitTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Bean Validation on inbound payloads. Every request DTO added from
         Phase 2 onward is validated at the boundary, not in a service. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Health, readiness and the Prometheus scrape endpoint. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Persistence. Flyway owns the schema and Hibernate only validates it
      against the mappings (ADR-0007), so these three always move together:
      the driver, the migration tool, and the ORM that checks the result.

      flyway-database-postgresql is a separate artifact from Flyway 10 onward.
      Without it Flyway starts, finds no PostgreSQL support, and fails at the
      first migration rather than at configuration time.

      spring-boot-flyway is the autoconfiguration, and in Spring Boot 4 it is
      its own module rather than part of spring-boot-autoconfigure. Without it
      flyway-core is on the classpath, every spring.flyway.* property binds to
      nothing, no migration runs, and the only symptom is Hibernate reporting a
      missing table - which reads like a mapping defect and is not one. Found by
      running the suite, not by reading the pom.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Real PostgreSQL for every test that touches the database. H2 is not
      acceptable evidence that a PostgreSQL migration works: it shares neither
      the type system, the constraint behaviour, nor the dialect, so a green H2
      run against a schema PostgreSQL would reject is worse than no test at all
      (ADR-0007).

      Testcontainers 2.x renamed its modules - `testcontainers-postgresql`, not
      `postgresql` - and moved PostgreSQLContainer to org.testcontainers.postgresql.
      The 1.x coordinates resolve to nothing on this BOM.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Repackages the application into an executable jar and provides
           `mvnw spring-boot:run` for local development. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Formatting is a build gate, not a suggestion. `mvnw spotless:apply`
        fixes; `mvnw verify` fails on a violation.

        Java only. sortPom is deliberately not enabled: this pom carries the
        reasoning for its own choices in comments, and reordering elements moves
        those comments away from what they explain for no reviewer benefit.

        palantir-java-format rather than google-java-format: google-java-format
        reaches into jdk.compiler internals and needs a growing list of
        add-exports JVM flags to run on a current JDK. Palantir's fork does not,
        and produces the same 4-space, AOSP-adjacent output this repository's
        .editorconfig already declares.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>
            <removeUnusedImports/>
            <importOrder>
              <order>java,javax,jakarta,org,com,</order>
            </importOrder>
            <licenseHeader>
              <content>/* SPDX-License-Identifier: Apache-2.0 */</content>
            </licenseHeader>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Unit tests. Fast, no Docker, no network. `*Tests.java` by convention;
        anything needing a container is an IT and belongs to Failsafe below.

        The image name is handed to the tests as a system property rather than
        hard-coded in a base class, so the pom stays the single place where the
        tested PostgreSQL version is written down.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>${skipUnitTests}</skipTests>
          <systemPropertyVariables>
            <sentinelflow.test.postgres.image>${postgres.test.image}</sentinelflow.test.postgres.image>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!--
        Integration tests: `*IT.java`, run at the `integration-test` phase
        against real PostgreSQL in a container. Failsafe rather than Surefire
        because Failsafe records a failure and lets `post-integration-test`
        run before `verify` fails the build - Surefire halts immediately and
        leaves containers behind.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <sentinelflow.test.postgres.image>${postgres.test.image}</sentinelflow.test.postgres.image>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Coverage over both suites. The unit and integration agents write to one
        exec file - JaCoCo appends - so the report reflects everything that ran
        rather than crediting only the faster half.

        `report` is bound to post-integration-test, not verify: a report that
        only exists when the build passes is missing exactly when it is wanted.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <configuration>
          <destFile>${project.build.directory}/jacoco.exec</destFile>
          <dataFile>${project.build.directory}/jacoco.exec</dataFile>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>prepare-agent-integration</id>
            <goals>
              <goal>prepare-agent-integration</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
