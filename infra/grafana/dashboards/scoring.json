{
  "uid": "sentinelflow-scoring",
  "title": "SentinelFlow \u2014 scoring",
  "description": "The model service, measured from both sides: what the caller waited for, and what the service says it spent.",
  "tags": ["sentinelflow", "scoring"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "SentinelFlow dashboards",
      "tags": ["sentinelflow"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "datasource": null,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Synthetic data.** SentinelFlow is an independent educational project. Every number on this dashboard describes generated transactions and a demo stack on one machine. None of it describes a real payment portfolio, and no figure here should be quoted as a benchmark."
      }
    },
    {
      "type": "stat",
      "title": "Model loaded",
      "description": "1 when the scoring service has a usable model. Zero means every assessment is degrading to rules, and Runbook 6 covers it.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": ["red"],
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "max(sentinelflow_scoring_model_loaded)",
          "legendFormat": "loaded",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Breaker",
      "description": "OPEN means calls are refused without an attempt. That is the breaker working \u2014 it is what stops a scoring outage becoming consumer lag proportional to traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": ["green"],
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "max(sentinelflow_scoring_breaker_state{application=\"sentinelflow-api\",state=\"OPEN\"})",
          "legendFormat": "open",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Degraded share",
      "description": "The fraction of assessments written without a model score over the last five minutes. Expected to be zero in a healthy stack.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": ["green"],
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(sentinelflow_risk_assessments_total{application=\"sentinelflow-api\",outcome=\"degraded\"}[5m])) or vector(0)) / clamp_min(sum(rate(sentinelflow_risk_assessments_total{application=\"sentinelflow-api\"}[5m])), 0.0001)",
          "legendFormat": "degraded",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Call rate",
      "description": "Scoring calls the API made per second, all outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(sentinelflow_scoring_calls_total{application=\"sentinelflow-api\"}[5m]))",
          "legendFormat": "calls/s",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Calls, by outcome",
      "description": "`scored` answered, `unavailable` did not within the budget, `rejected` refused the request, `breaker_open` was never attempted. Collapsing unavailable and rejected into one line would hide the difference between a dependency being down and two services disagreeing about a contract.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(sentinelflow_scoring_calls_total{application=\"sentinelflow-api\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Caller-side latency, scored calls",
      "description": "Wall-clock across every attempt including backoff, as measured by the API. Compare with the service-side histogram below: the gap between them is the network and the retries, which is what tells a slow model from a slow link.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(sentinelflow_scoring_call_duration_seconds_bucket{application=\"sentinelflow-api\",outcome=\"scored\"}[5m])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sentinelflow_scoring_call_duration_seconds_bucket{application=\"sentinelflow-api\",outcome=\"scored\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(sentinelflow_scoring_call_duration_seconds_bucket{application=\"sentinelflow-api\",outcome=\"scored\"}[5m])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Service-side inference duration",
      "description": "The scoring service measuring itself: feature extraction plus inference, with no network in it.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(sentinelflow_scoring_inference_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sentinelflow_scoring_inference_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(sentinelflow_scoring_inference_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Service-side requests, by outcome",
      "description": "As the scoring service counts them. A disagreement with the caller-side panel is worth investigating: it means requests are being lost between the two.",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinelflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinelflow-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(sentinelflow_scoring_requests_total[5m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    }
  ]
}
